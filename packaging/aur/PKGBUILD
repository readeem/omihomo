# Maintainer: readeem <https://github.com/readeem>
#
# The release workflow publishes this file to the AUR from packaging/aur in
# https://github.com/readeem/omihomo, filling in pkgver and the checksum of the
# release tarball it built. Change it there, not on the AUR.
pkgname=omihomo-bin
pkgver=0.0.0
pkgrel=1
pkgdesc='Daemon for the Omihomo Omarchy widget: the mihomo proxy core as a sandboxed system service'
arch=('x86_64')
url='https://github.com/readeem/omihomo'
license=('GPL-3.0-only')
depends=('systemd')
provides=('omihomo')
conflicts=('omihomo')
install=omihomo.install
# A static Go binary, already stripped by the build.
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/omihomo-$pkgver-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "omihomo-$pkgver"
  install -Dm755 omihomo "$pkgdir/usr/bin/omihomo"
  install -Dm644 omihomo.service "$pkgdir/usr/lib/systemd/system/omihomo.service"
  install -Dm644 omihomo.socket "$pkgdir/usr/lib/systemd/system/omihomo.socket"
  install -Dm644 omihomo.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/omihomo.conf"
  install -Dm644 THIRD_PARTY_LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES"
}
