# PID 1 creates the socket so it can belong to the owner: the sandboxed daemon
# has no CAP_CHOWN. `omihomo claim` sets SocketUser= in
# /etc/systemd/system/omihomo.socket.d/owner.conf; until then the socket is
# root's and the daemon refuses everyone anyway.
[Unit]
Description=Omihomo daemon socket
Documentation=https://github.com/readeem/omihomo/blob/main/docs/daemon.md

[Socket]
ListenStream=/run/omihomo/omihomo.sock
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target
