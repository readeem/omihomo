Close the socket when a TCP TLS handshake fails

The raw dial succeeds before validation. The caller only receives an error and cannot close that socket.

diff --git i/transport/internet/tcp/dialer.go w/transport/internet/tcp/dialer.go
index 47779c7..8d7bcb2 100644
--- i/transport/internet/tcp/dialer.go
+++ w/transport/internet/tcp/dialer.go
@@ -82,6 +82,7 @@ func Dial(ctx context.Context, dest net.Destination, streamSettings *internet.Me
 			err = conn.(*tls.Conn).HandshakeContext(ctx)
 		}
 		if err != nil {
+			conn.Close()
 			if isFromMitmVerify {
 				return nil, errors.New("MITM freedom RAW TLS: failed to verify Domain Fronting certificate from " + mitmServerName).Base(err)
 			}
