Preserve Hysteria 2 UDP receive order

Tracked in Omihomo PR #74. TestHysteriaReceivesDatagramsInPeerOrder covers delivery.

--- a/hysteria2/client_packet.go
+++ b/hysteria2/client_packet.go
@@ -9,12 +9,11 @@
 			conn.closeWithError(E.Cause(err, "receive message"))
 			return
 		}
-		go func() {
-			hErr := c.handleMessage(conn, message)
-			if hErr != nil {
-				conn.closeWithError(E.Cause(hErr, "handle message"))
-			}
-		}()
+		// A goroutine per datagram can deliver later packets before earlier ones.
+		if err := c.handleMessage(conn, message); err != nil {
+			conn.closeWithError(E.Cause(err, "handle message"))
+			return
+		}
 	}
 }
 
