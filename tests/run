#!/usr/bin/env bash
set -euo pipefail
here=$(dirname "$0")

command -v node >/dev/null 2>&1 || {
  printf 'tests require node for the widget model tests\n' >&2
  exit 2
}
node --test "$here/model_test.js"

if command -v qs >/dev/null 2>&1 && [[ -d /usr/share/omarchy/shell/Commons ]]; then
  "$here/service_state_test.sh"
  "$here/ping_state_test.sh"
else
  printf 'skipping QML service tests: Quickshell or Omarchy shell imports are not installed\n'
fi

if [[ -n ${OMIHOMO_TEST_YQ:-} ]]; then
  [[ -x $OMIHOMO_TEST_YQ ]] || { printf 'OMIHOMO_TEST_YQ is not executable: %s\n' "$OMIHOMO_TEST_YQ" >&2; exit 2; }
else
  command -v yq >/dev/null 2>&1 || {
    printf 'tests require yq; set OMIHOMO_TEST_YQ to a yq v4 executable\n' >&2
    exit 2
  }
fi

if [[ ${OMIHOMO_REAL_CORE_TEST:-0} == 1 ]]; then
  "$here/real_provider_test.sh"
fi
exec "$here/cli_test.sh"
