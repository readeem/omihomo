#!/usr/bin/env bash
set -euo pipefail
unformatted=$(gofmt -l .)
[[ -z $unformatted ]] || { printf 'gofmt needed:\n%s\n' "$unformatted"; exit 1; }
go fix -diff ./...
go vet ./...
go vet -tags= ./...
packages=$(go list ./...)
# mixray races with itself, so its package runs without -race.
mapfile -t race_packages < <(grep -v '/internal/core/mixray$' <<<"$packages")
go test -race "${race_packages[@]}"
go test ./internal/core/mixray
