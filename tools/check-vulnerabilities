#!/usr/bin/env bash
set -euo pipefail
export GOWORK=off

# Mixray rewrites upstream module paths, making them invisible to binary scans.
go mod download github.com/readeem/mixray
mixray_dir=$(go list -m -f '{{.Dir}}' github.com/readeem/mixray)
upstream="$mixray_dir/upstream.json"
pins=("$(jq -er '.mihomo | "\(.module)@\(.version)"' "$upstream")")
while IFS= read -r pin; do
  [[ -n $pin ]] && pins+=("$pin")
done < <(jq -r '.vendored // {} | to_entries[] | "\(.value.module)@\(.value.version)"' "$upstream")

advisories=$(govulncheck -mode query -format json "${pins[@]}" | jq -s '[.[] | .osv? | select(.) | {id, summary}]')
if [[ $advisories != '[]' ]]; then
  printf 'Advisories for pinned upstream module versions:\n%s\n' "$advisories" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
version=$(jq -er .version manifest.json)
tools/stage-release "$work/stage" "$work/vendor" "$version"
govulncheck -mode binary "$work/stage/omihomo"
govulncheck -mode binary "$work/stage/omihomo-update"
