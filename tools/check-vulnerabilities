#!/usr/bin/env bash
set -euo pipefail
export GOWORK=off

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
version=$(jq -er .version manifest.json)
tools/stage-release "$work/stage" "$work/vendor" "$version"
govulncheck -mode binary "$work/stage/omihomo"
govulncheck -mode binary "$work/stage/omihomo-update"
