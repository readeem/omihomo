#!/usr/bin/env bash
set -euo pipefail
umask 077

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
mkdir -p dist/hosting
binary=dist/hosting/xray
binary_hash=cc4b84d3069569f297a61f04b914f2bb37e9d202fd7b84cb50def1fc30fd40e1
if ! printf '%s  %s\n' "$binary_hash" "$binary" | sha256sum --check --status 2>/dev/null; then
  work=$(mktemp -d "$root/dist/hosting/download.XXXXXX")
  trap 'rm -rf -- "$work"' EXIT
  curl --fail --location --silent --show-error --max-time 60 --max-filesize 33554432 \
    https://github.com/XTLS/Xray-core/releases/download/v26.10.31/Xray-linux-64.zip \
    --output "$work/xray.zip"
  printf '%s  %s\n' e4bd9119f50ae7c41658b1abd0679ae06f98bd864a2907ff33f2f2cf7081b214 "$work/xray.zip" | sha256sum --check --status
  unzip -p "$work/xray.zip" xray > "$work/xray"
  printf '%s  %s\n' "$binary_hash" "$work/xray" | sha256sum --check --status
  chmod 0700 "$work/xray"
  mv "$work/xray" "$binary"
fi
mise run hosting-experiment
