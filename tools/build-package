#!/usr/bin/env bash
set -euo pipefail
umask 077

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
for tool in go makepkg jq zstd fakeroot; do
  command -v "$tool" >/dev/null || { printf 'build needs %s\n' "$tool" >&2; exit 1; }
done
version=$(jq -r .version manifest.json)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
name=omihomo-$version
mkdir -p dist
work=$(mktemp -d "$root/dist/.package-XXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/$name" "$work/build"
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -tags with_gvisor,no_easytier -trimpath \
  -ldflags "-s -w -X github.com/readeem/omihomo/internal/cli.Version=v$version" \
  -o "$work/$name/omihomo" ./cmd/omihomo
install -m644 packaging/omihomo.service packaging/omihomo.socket packaging/omihomo.tmpfiles packaging/omihomo-apply.path packaging/omihomo-apply.service LICENSE "$work/$name/"
go mod vendor -o "$work/vendor"
(cd "$work" && find vendor -type f \( -name 'LICEN[CS]E*' -o -name 'COPYING*' -o -name 'NOTICE*' -o -name 'PATENTS*' \) |
  LC_ALL=C sort | while read -r file; do printf '==> %s <==\n' "${file#vendor/}"; cat "$file"; echo; done) > "$work/$name/THIRD_PARTY_LICENSES"
tar --sort=name --mtime="@$(git log -1 --format=%ct)" --owner=0 --group=0 --numeric-owner \
  -C "$work" -cf - "$name" | gzip -n > "dist/$name-x86_64.tar.gz"
(cd dist && sha256sum "$name-x86_64.tar.gz" > "$name-x86_64.tar.gz.sha256")
tar --sort=name --mtime="@$(git log -1 --format=%ct)" --owner=0 --group=0 --numeric-owner \
  -C "$work" -cf - vendor | gzip -n > "dist/$name-vendor.tar.gz"
(cd dist && sha256sum "$name-vendor.tar.gz" > "$name-vendor.tar.gz.sha256")
checksum=$(cut -d' ' -f1 "dist/$name-x86_64.tar.gz.sha256")
cp packaging/aur/PKGBUILD packaging/aur/omihomo.install "$work/build/"
sed -i -e "s/^pkgver=.*/pkgver=$version/" -e "s/^sha256sums=.*/sha256sums=('$checksum')/" "$work/build/PKGBUILD"
cp "dist/$name-x86_64.tar.gz" "$work/build/"
(cd "$work/build" && makepkg --nodeps --noconfirm && makepkg --printsrcinfo > .SRCINFO)
mkdir -p dist/aur
install -m644 "$work/build/PKGBUILD" "$work/build/.SRCINFO" "$work/build/omihomo.install" dist/aur/
cp "$work/build/omihomo-bin-$version-1-x86_64.pkg.tar.zst" dist/
printf '\nBuilt %s/dist/omihomo-bin-%s-1-x86_64.pkg.tar.zst\n' "$root" "$version"
printf 'Install and cut over after the current session: sudo pacman -U dist/omihomo-bin-%s-1-x86_64.pkg.tar.zst\n' "$version"
printf 'Then: sudo /usr/bin/omihomo claim && omarchy restart shell\n'
