#!/usr/bin/env bash
set -euo pipefail
umask 077

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
for tool in go makepkg jq zstd fakeroot; do
  command -v "$tool" >/dev/null || { printf 'build needs %s\n' "$tool" >&2; exit 1; }
done
version=$(jq -r .version manifest.json)
[[ $version =~ ^(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]]
name=omihomo-$version
mkdir -p dist
work=$(mktemp -d "$root/dist/.package-XXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/$name" "$work/build"
tools/with-go-patches tools/stage-release "$work/$name" "$work/vendor" "$version"
install -m755 "$work/$name/omihomo-update" "dist/omihomo-update-$version-x86_64"
(cd dist && sha256sum "omihomo-update-$version-x86_64" > "omihomo-update-$version-x86_64.sha256")
tar --sort=name --mtime="@$(git log -1 --format=%ct)" --owner=0 --group=0 --numeric-owner \
  -C "$work" -cf - "$name" | gzip -n > "dist/$name-x86_64.tar.gz"
(cd dist && sha256sum "$name-x86_64.tar.gz" > "$name-x86_64.tar.gz.sha256")
tar --sort=name --mtime="@$(git log -1 --format=%ct)" --owner=0 --group=0 --numeric-owner \
  -C "$work" -cf - vendor | gzip -n > "dist/$name-vendor.tar.gz"
(cd dist && sha256sum "$name-vendor.tar.gz" > "$name-vendor.tar.gz.sha256")
checksum=$(cut -d' ' -f1 "dist/$name-x86_64.tar.gz.sha256")
cp packaging/PKGBUILD packaging/omihomo.install "$work/build/"
sed -i -e "s/^pkgver=.*/pkgver=$version/" -e "s/^sha256sums=.*/sha256sums=('$checksum')/" "$work/build/PKGBUILD"
cp "dist/$name-x86_64.tar.gz" "$work/build/"
SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
export SOURCE_DATE_EPOCH
(cd "$work/build" && makepkg --nodeps --noconfirm)
cp "$work/build/omihomo-$version-1-x86_64.pkg.tar.zst" dist/
(cd dist && sha256sum "omihomo-$version-1-x86_64.pkg.tar.zst" > "omihomo-$version-1-x86_64.pkg.tar.zst.sha256")
printf '\nBuilt %s/dist/omihomo-%s-1-x86_64.pkg.tar.zst\n' "$root" "$version"
printf 'Install and cut over after the current session: sudo pacman -U dist/omihomo-%s-1-x86_64.pkg.tar.zst\n' "$version"
printf 'Then: sudo /usr/bin/omihomo claim && omarchy restart shell\n'
