#!/usr/bin/env bash
set -euo pipefail
umask 077

[[ $EUID != 0 ]] || { printf 'Run as the account that should own Omihomo, without sudo around this script.\n' >&2; exit 1; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=$(jq -r .version "$root/manifest.json")
package="$root/dist/omihomo-bin-$version-1-x86_64.pkg.tar.zst"
[[ -f $package ]] || { printf 'Build the package first with tools/build-package.\n' >&2; exit 1; }
command -v omarchy >/dev/null || { printf 'This test needs an Omarchy installation.\n' >&2; exit 1; }

printf 'This installs the local test package and cuts over the proxy. Connections may briefly drop.\n'
printf 'The existing plugin will be kept as a backup before linking this checkout.\n'
sudo pacman -U "$package"
sudo /usr/bin/omihomo claim \
  --legacy-data "${XDG_DATA_HOME:-$HOME/.local/share}/omihomo" \
  --legacy-config "${XDG_CONFIG_HOME:-$HOME/.config}"

plugins="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin="$plugins/dev.readeem.omihomo"
backup=
linked=0
restore_plugin() {
  if [[ $linked == 0 && -n $backup && ! -e $plugin && ! -L $plugin ]]; then
    mv -- "$backup/plugin" "$plugin"
    rmdir -- "$backup"
  fi
}
trap restore_plugin EXIT
mkdir -p "$plugins"
if [[ -L $plugin && $(readlink -- "$plugin") == "$root" ]]; then
  linked=1
else
  if [[ -e $plugin || -L $plugin ]]; then
    backup=$(mktemp -d "$plugins/.omihomo-before-cutover.XXXXXX")
    mv -- "$plugin" "$backup/plugin"
  fi
  ln -s -- "$root" "$plugin"
  linked=1
fi
[[ -z $backup ]] || printf 'Previous plugin retained at %s/plugin\n' "$backup"
omarchy plugin enable dev.readeem.omihomo
omarchy bar move dev.readeem.omihomo
omarchy restart shell
/usr/bin/omihomo status
printf 'Follow tests/README.md to test subscriptions, routing, reboot and removal.\n'
