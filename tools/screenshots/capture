#!/usr/bin/env bash
# Recaptures the README screenshots from the real panel, fed fixed data.
# Usage: tools/screenshots/capture [output-dir]   (default: the repository)
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/stage"
out=$(realpath -m "${1:-$root}")
wallpaper=/usr/share/omarchy/themes/tokyo-night/backgrounds/1-winding-road.webp
[[ -e $wallpaper ]] || { printf 'capture needs %s\n' "$wallpaper" >&2; exit 2; }

umask 077
work= child= daemon=
cleanup() {
  trap '' INT TERM
  [[ -z $child ]] || { kill -TERM "$child" 2>/dev/null; wait "$child" || true; }
  [[ -z $daemon ]] || { kill -TERM "$daemon" 2>/dev/null; wait "$daemon" || true; }
  [[ -z $work ]] || rm -rf -- "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
work=$(mktemp -d /tmp/omihomo-shots.XXXXXX)
mkdir "$work/out"

stage "$work" "$here/capture.qml"
start_daemon "$work"

log=$work/capture.log
"${panel_env[@]}" QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR=2 \
  OMIHOMO_SHOTS_OUT="$work/out" OMIHOMO_SHOTS_WALLPAPER="file://$wallpaper" \
  timeout -k 5s 60s qs --no-color -p "$config" >"$log" 2>&1 &
child=$!
wait "$child" || true
child=

grep -q CAPTURE_DONE "$log" || { cat "$log" >&2; printf 'capture failed\n' >&2; exit 1; }
mkdir -p "$out/assets/screenshots"
mv "$work/out/preview.png" "$out/"
mv "$work"/out/*.png "$out/assets/screenshots/"
printf 'wrote %s/preview.png and %s/assets/screenshots/\n' "$out" "$out"
